# Database Configuration
DATABASE_URL=sqlite:///./herwell.db

# LLM Provider Configuration
# Choose one: gemini, openai, anthropic, or mock
LLM_PROVIDER=mock

# API Keys (configure the one matching your LLM_PROVIDER)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Specify a custom model
# For Gemini: gemini-1.5-flash, gemini-1.5-pro
# For OpenAI: gpt-4o-mini, gpt-4o
# For Anthropic: claude-3-5-haiku-latest, claude-3-5-sonnet-latest
# LLM_MODEL=gemini-1.5-flash

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
